{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<section class="product">

  <div class="product__inner">

    <div class="product__media">
      <div class="product__main-image">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 800 | image_tag }}
        {% endif %}
      </div>
    </div>
    
    <div class="product__info">

      {% comment %} Product title and description {% endcomment %}
      {% if product.title != blank or product.description != blank %}
        <header class="product__header">
          {% if product.title != blank %}
            <h1 class="product__title">{{ product.title }}</h1>
          {% endif %}
          {% if product.description != blank %}
            <div class="product__description">{{ product.description }}</div>
          {% endif %}
        </header>
      {% endif %}

      {% comment %} Product benefits {% endcomment %}
      {% if section.blocks.size > 0 %}
        <ul class="product__benefits">
          {% for block in section.blocks %}
            <li class="product__benefit" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% comment %} Product form {% endcomment %}
      {% assign current_variant = product.selected_or_first_available_variant %}
      {% form 'product', product, class: "product__form" %}

        <fieldset class="product__packs">

          <legend class="product__packs-legend">Pack size:</legend>

          <div class="product__packs-grid">

            {% for variant in product.variants %}
              {% assign savings = 0 %}
              {% if variant.compare_at_price > variant.price %}
                {% assign savings = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price | round %}
              {% endif %}

              <input
              type="radio"
              class="product__pack-input"
              name="id"
              value="{{ variant.id }}"
              id="variant-{{ variant.id }}"
              {% if variant.id == current_variant.id %}checked{% endif %}
              >
              <label for="variant-{{ variant.id }}" class="product__pack-label">
                <span class="product__pack-title">{{ variant.title }}</span>
                <span class="product__pack-prices">
                  <span class="product__pack-price">
                    {{ variant.price | money_without_trailing_zeros }}
                  </span>
                  {% if variant.compare_at_price > variant.price %}
                    <s class="product__pack-compare">
                      {{ variant.compare_at_price | money_without_trailing_zeros }}
                    </s>
                  {% endif %}
                </span>
                {%  if savings > 0 %}
                  <span class="product__pack-badge">save {{ savings }}%</span>
                {% endif %}
              </label>
            {% endfor %}

          </div>

        </fieldset>

        <button type="submit" class="product__add-to-cart-button">
          Add to cart - {{ current_variant.price | money_without_trailing_zeros }}
        </button>
        
      {% endform %}

    </div>

  </div>

</section>


{% stylesheet %}

.product__inner {
  display: flex;
  gap: 2rem;
}

.product__media {
  display: flex;
}

.product__info {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.product__header {
  display: flex;
  flex-direction: column;
}

.product__title {
  font-size: 3rem;
  line-height: 100%;
}

.product__description {
  font-size: 1rem;
  line-height: 150%;
}

.product__benefits {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  list-style: none;
  line-height: 150%;
  padding: 0;
  margin: 0;
}

.product__form {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.product__packs {
  border: 0;
  padding: 0;
  margin: 0;
}

.product__packs-legend {
  padding: 0;
  font-weight: 700;
  margin-bottom: 1rem;
}

.product__packs-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.product__pack-input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.product__pack-label {
  position: relative;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  padding: 1rem 1.5rem;
  cursor: pointer;
  border: 1px solid #121212;
  border-radius: 1rem;
  font-size: 1rem;
  font-weight: 700;
}

.product__pack-prices {
  display: flex;
  align-items: baseline;
  gap: 0.375rem;
}

.product__pack-badge {
  position: absolute;
  bottom: -0.75rem;
  left: 50%;
  transform: translateX(-50%);
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  background-color: #ff3eb5;
  color: #121212;
  font-size: 0.75rem;
  white-space: nowrap;
}

.product__pack-input:checked + .product__pack-label {
  background-color: #121212;
  color: #ffffff;
}

.product__pack-input:focus-visible + .product__pack-label {
  outline: 2px solid #121212;
  outline-offset: 2px;
}

{% endstylesheet %}


{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Support mood & focus"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}